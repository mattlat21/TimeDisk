        "return Object.assign({},WEB_THEME_DEFAULTS,t)}"
        "function saveWebTheme(t){webTheme=t;localStorage.setItem(WEB_THEME_KEY,JSON.stringify(t));applyWebTheme(t)}"
        "function resolvedThemeMode(mode){if(mode==='auto'){return matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'}"
        "return mode==='dark'?'dark':'light'}"
        "function applyWebTheme(t){webTheme=t||webTheme||loadWebTheme();const r=document.documentElement.style;"
        "document.documentElement.dataset.theme=resolvedThemeMode(webTheme.mode);"
        "r.setProperty('--primary',webTheme.primary);r.setProperty('--accent',webTheme.accent);"
