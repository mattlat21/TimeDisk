        "async function saveCfg(patch){await api('/api/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(patch)});Object.assign(cfg,patch);toast('Saved')}"
        "function toast(m){const t=document.createElement('div');t.textContent=m;t.style.cssText="
        "'position:fixed;bottom:20px;right:20px;background:var(--accent);color:#102010;padding:10px 16px;border-radius:8px';"
        "document.body.appendChild(t);setTimeout(()=>t.remove(),2000)}"
        "function applyTheme(mode){document.documentElement.dataset.theme=mode;"
        "localStorage.setItem('timedisk-theme',mode);"
        "$('theme-btn').textContent=mode==='light'?'Dark mode':'Light mode'}"
        "function initTheme(){applyTheme(localStorage.getItem('timedisk-theme')||'light')}"
        "$('theme-btn').onclick=()=>applyTheme(document.documentElement.dataset.theme==='light'?'dark':'light');"
        "initTheme();"
        "async function ensureCfg(){if(!cfg)cfg=await api('/api/config');return cfg}"
        "function statusRow(id,k,v){return '<div class=\"status-row\"><span>'+esc(k)+'</span><span id=\"'+id+'\">'+esc(v)+'</span></div>'}"
        "function stopPoll(){if(pollTimer){clearInterval(pollTimer);pollTimer=null}}"
        "function startPoll(ms,fn){stopPoll();pollTimer=setInterval(fn,ms)}"
        "function mergeCfgFromApi(c){if(!c)return;if(!cfg)cfg={};Object.assign(cfg,c)}"
        "function patchVal(id,v){const el=$(id);if(!el||document.activeElement===el)return;el.value=v}"
