        "function initWebTheme(){webTheme=loadWebTheme();applyWebTheme(webTheme);"
        "matchMedia('(prefers-color-scheme:dark)').addEventListener('change',()=>{if(webTheme&&webTheme.mode==='auto')applyWebTheme(webTheme)})}"
