        "let pos=di-offset;for(let k=0;k<matchLen;k++)dst[di++]=dst[pos++]}"
        "if(di!==rawLen)throw new Error('LZ4 length mismatch');return dst}"
        "function lvglRgb565ToRgba(raw,w,h,stride){const out=new Uint8ClampedArray(w*h*4);let o=0;"
        "for(let y=0;y<h;y++){const row=y*stride;for(let x=0;x<w;x++){const i=row+x*2;"
        "const px=raw[i]|(raw[i+1]<<8);out[o++]=Math.round(((px>>11)&0x1f)*255/31);"
        "out[o++]=Math.round(((px>>5)&0x3f)*255/63);out[o++]=Math.round((px&0x1f)*255/31);out[o++]=255}}"
        "return out}"
        "function lvglParseBin(buf){const v=new DataView(buf);if(v.byteLength<12)throw new Error('File too short');"
        "if(v.getUint8(0)!==0x19)throw new Error('Bad magic');const cf=v.getUint8(1);"
        "if(cf!==0x12)throw new Error('Unsupported format');const flags=v.getUint16(2,true);"
        "const w=v.getUint16(4,true),h=v.getUint16(6,true),stride=v.getUint16(8,true);"
        "let payload=new Uint8Array(buf,12);if(flags&0x08){if(payload.length<12)throw new Error('Bad compress header');"
        "const pv=new DataView(payload.buffer,payload.byteOffset,payload.byteLength);"
        "const method=pv.getUint32(0,true),compLen=pv.getUint32(4,true),rawLen=pv.getUint32(8,true);"
        "const comp=payload.subarray(12,12+compLen);"
        "if(method===1)payload=lvglDecompressRle(comp,rawLen,2);"
        "else if(method===2)payload=lvglDecompressLz4(comp,rawLen);"
        "else throw new Error('Unknown compression')}"
        "return{w,h,stride,pixels:payload}}"
        "async function lvglBinToCanvas(canvas,name,statusEl){try{"
        "const r=await fetch('/api/images/file?name='+encodeURIComponent(name));"
        "if(!r.ok)throw new Error('Fetch failed');const buf=await r.arrayBuffer();"
        "const img=lvglParseBin(buf);canvas.width=img.w;canvas.height=img.h;"
        "const rgba=lvglRgb565ToRgba(img.pixels,img.w,img.h,img.stride);"
        "const ctx=canvas.getContext('2d');ctx.imageSmoothingEnabled=false;"
        "ctx.putImageData(new ImageData(rgba,img.w,img.h),0,0);"
        "if(statusEl)statusEl.remove()}catch(e){if(statusEl){statusEl.textContent='Preview unavailable';"
        "statusEl.className='img-preview-err'}}}"
        "async function decodeImagePreviews(root){const queue=[...root.querySelectorAll("
        "'canvas.img-preview-canvas:not([data-done]),canvas.mode-tile-canvas:not([data-done])')];"
        "async function next(){const c=queue.shift();if(!c)return;"
        "const st=c.parentElement.querySelector('.img-preview-loading,.mode-tile-loading');"
        "await lvglBinToCanvas(c,c.dataset.name,st);c.dataset.done='1';c.classList.remove('hidden');return next()}"
        "return next()}"
        "const IMG_DISPLAY_NAMES={'tod_rest.bin':'Rest Background','tod_sleep.bin':'Sleep Background',"
        "'btn_start_rest.bin':'Start Rest Button','btn_start_sleep.bin':'Start Sleep Button',"
        "'btn_start_wake.bin':'Start Wake Button','first_boot_screen.bin':'First Boot Screen',"
        "'splash.bin':'Splash Screen','btn_start_timer.bin':'Start Timer Button',"
        "'tod_wake.bin':'Wake Background','tod_winddown.bin':'Wind Down Background'};"
        "function imageDisplayName(filename){if(IMG_DISPLAY_NAMES[filename])return IMG_DISPLAY_NAMES[filename];"
        "return filename.replace(/\\.bin$/i,'').replace(/_/g,' ').replace(/\\b\\w/g,c=>c.toUpperCase())}"
        "function sortImageFiles(files,sort){const k=sort.key,dir=sort.dir;"
        "return files.slice().sort((a,b)=>{let av,bv;"
        "if(k==='size'){av=Math.max(0,Math.floor(Number(a.size_bytes)||0));bv=Math.max(0,Math.floor(Number(b.size_bytes)||0));"
        "return(av-bv)*dir}"
        "if(k==='name'){av=a.name||'';bv=b.name||''}else{av=a.displayName||'';bv=b.displayName||''}"
        "return av.localeCompare(bv,undefined,{sensitivity:'base'})*dir})}"
        "function updateImageSortHeaders(el,sort){el.querySelectorAll('th.sortable').forEach(th=>{"
        "const on=th.dataset.sort===sort.key;th.classList.toggle('sorted',on);"
        "let ind=th.querySelector('.sort-ind');if(!ind){ind=document.createElement('span');ind.className='sort-ind';th.appendChild(ind)}"
        "ind.textContent=on?(sort.dir>0?'\\u25b2':'\\u25bc'):''})}"
        "function reorderImageRows(el,files,sort){const tb=el.querySelector('#img-tbody');if(!tb)return;"
        "const map=new Map([...tb.querySelectorAll('tr')].map(r=>[r.dataset.name,r]));"
        "sortImageFiles(files,sort).forEach(f=>{const row=map.get(f.name);if(row)tb.appendChild(row)});"
        "updateImageSortHeaders(el,sort)}"
        "function closeImageModal(){const ov=$('img-modal');if(ov)ov.classList.add('hidden')}"
        "function ensureImageModal(){let ov=$('img-modal');if(ov)return ov;"
        "ov=document.createElement('div');ov.id='img-modal';ov.className='modal-overlay hidden';"
        "ov.innerHTML='<div class=\"modal modal-img\" role=\"dialog\" aria-modal=\"true\">"
        "<div class=\"modal-img-head\"><h3 id=\"img-modal-title\">Image</h3>"
        "<button type=\"button\" class=\"icon-btn\" id=\"img-modal-close\" aria-label=\"Close\">\\u00d7</button></div>"
        "<p class=\"modal-sub\" id=\"img-modal-sub\"></p>"
        "<div class=\"img-modal-body\"><canvas id=\"img-modal-canvas\" class=\"img-modal-canvas\"></canvas></div></div>';"
        "document.body.appendChild(ov);"
        "ov.onclick=e=>{if(e.target===ov)closeImageModal()};"
        "$('img-modal-close').onclick=closeImageModal;return ov}"
        "function openImageModal(srcCanvas,name,displayName){ensureImageModal();"
        "$('img-modal-title').textContent=displayName||name;"
        "$('img-modal-sub').textContent=name+' \\u00b7 '+srcCanvas.width+'\\u00d7'+srcCanvas.height;"
        "const c=$('img-modal-canvas');c.width=srcCanvas.width;c.height=srcCanvas.height;"
        "const ctx=c.getContext('2d');ctx.imageSmoothingEnabled=false;ctx.drawImage(srcCanvas,0,0);"
        "$('img-modal').classList.remove('hidden')}"
