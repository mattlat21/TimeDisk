        "+'<div class=\"form-row hidden\" id=\"se-dur-wrap\"><label>Duration</label>"
        "<div class=\"chk-row\"><input type=\"checkbox\" id=\"se-dur-en\"><label for=\"se-dur-en\">Use custom duration</label></div>'"
        "+'<div class=\"dur-fields hidden\" id=\"se-dur-fields\">"
        "<input type=\"number\" id=\"se-dur-h\" min=\"0\" max=\"48\" value=\"12\" placeholder=\"Hours\">"
        "<span>hours</span><input type=\"number\" id=\"se-dur-m\" min=\"0\" max=\"59\" value=\"0\" placeholder=\"Min\">"
        "<span>minutes</span></div><p class=\"hint\" id=\"se-dur-hint\">Otherwise defaults to 24 hours.</p></div>'"
        "+'<div class=\"chk-row\"><input type=\"checkbox\" id=\"se-enabled\" checked><label for=\"se-enabled\">Enabled</label></div>'"
        "+'<div class=\"modal-actions\"><button type=\"button\" class=\"btn btn-secondary\" id=\"se-cancel\">Cancel</button>'"
        "+'<button type=\"button\" class=\"btn\" id=\"se-save\">Save</button></div></div></div>'"
        "+'<div class=\"modal-overlay hidden\" id=\"sched-del-modal\"><div class=\"modal\" role=\"dialog\">"
        "<h3>Delete event?</h3><p class=\"modal-sub\" id=\"sched-del-msg\">This cannot be undone.</p>'"
        "+'<div class=\"modal-actions\"><button type=\"button\" class=\"btn btn-secondary\" id=\"sd-cancel\">Cancel</button>'"
        "+'<button type=\"button\" class=\"btn btn-danger\" id=\"sd-confirm\">Delete</button></div></div></div>';"
        "function schedSyncDurUi(){const act=$('se-action').value,isWake=act==='wake';"
        "$('se-dur-wrap').classList.toggle('hidden',isWake);if(isWake)return;"
        "const custom=$('se-dur-en').checked;$('se-dur-fields').classList.toggle('hidden',!custom);"
        "$('se-dur-hint').textContent=custom?'Enter hours and minutes.':'Defaults to 24 hours when saved.'}"
        "function schedOpenEdit(index){editIndex=index;const cur=index>=0?(evData.events||[]).find(e=>e.index===index):null;"
        "const tm=cur?cur.time_min:420;const act=cur?cur.action:'wake';"
        "$('sched-edit-title').textContent=index>=0?'Edit event':'Add event';"
        "$('se-hour').innerHTML=schedHourOpts(Math.floor(tm/60));$('se-min').innerHTML=schedMinOpts(tm%60);"
        "$('se-action').value=act;$('se-enabled').checked=cur?!!cur.enabled:true;"
        "const sec=cur?cur.duration_sec:0;const custom=act!=='wake'&&sec>0&&sec!==SCHED_DEFAULT_DUR;"
        "$('se-dur-en').checked=custom;if(custom){$('se-dur-h').value=Math.floor(sec/3600);"
        "$('se-dur-m').value=Math.floor((sec%3600)/60)}else{$('se-dur-h').value=12;$('se-dur-m').value=0}"
        "schedSyncDurUi();$('sched-edit-modal').classList.remove('hidden')}"
        "function schedCloseEdit(){$('sched-edit-modal').classList.add('hidden');editIndex=-1}"
        "function schedOpenDel(index){delIndex=index;const cur=(evData.events||[]).find(e=>e.index===index);"
        "const msg=cur?'Delete '+schedFmtTime(cur.time_min)+' · '+schedFmtEvent(cur.action)+'?':'Delete this event?';"
        "$('sched-del-msg').textContent=msg;$('sched-del-modal').classList.remove('hidden')}"
        "function schedCloseDel(){$('sched-del-modal').classList.add('hidden');delIndex=-1}"
        "function paintEvents(data){evData=data;const tb=$('ev-tbody');const events=(data.events||[]).slice().sort((a,b)=>a.time_min-b.time_min);"
        "if(!events.length){tb.innerHTML='<tr><td colspan=\"4\" class=\"sched-empty\">No scheduled events yet.</td></tr>';return}"
        "tb.innerHTML=events.map(e=>{const cls=e.enabled?'':' sched-off';"
        "return '<tr class=\"'+cls+'\"><td>'+schedFmtTime(e.time_min)+'</td><td>'+schedFmtDur(e.duration_sec,e.action)+'</td>'"
        "+'<td>'+schedFmtEvent(e.action)+(e.enabled?'':' (off)')+'</td>'"
        "+'<td class=\"actions\"><button type=\"button\" class=\"icon-btn\" title=\"Edit\" data-edit=\"'+e.index+'\">&#9998;</button>'"
        "+'<button type=\"button\" class=\"icon-btn danger\" title=\"Delete\" data-del=\"'+e.index+'\">&#10005;</button></td></tr>'}).join('');"
        "tb.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>schedOpenEdit(+b.dataset.edit));"
        "tb.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>schedOpenDel(+b.dataset.del))}"
        "$('ev-add').onclick=()=>schedOpenEdit(-1);"
        "$('se-action').onchange=schedSyncDurUi;$('se-dur-en').onchange=schedSyncDurUi;"
        "$('se-cancel').onclick=schedCloseEdit;"
        "$('sched-edit-modal').onclick=e=>{if(e.target===$('sched-edit-modal'))schedCloseEdit()};"
        "$('se-save').onclick=async()=>{const act=$('se-action').value;"
        "const time_min=+ $('se-hour').value*60+ +$('se-min').value;"
        "let duration_sec=0;if(act!=='wake'){duration_sec=SCHED_DEFAULT_DUR;"
        "if($('se-dur-en').checked){duration_sec=+ $('se-dur-h').value*3600+ +$('se-dur-m').value*60;"
        "if(duration_sec<=0){toast('Enter a duration or uncheck custom duration');return}}}"
        "const body={time_min,action:act,duration_sec,enabled:$('se-enabled').checked};"
        "if(editIndex>=0){body.index=editIndex;await api('/api/schedule/events/edit',{method:'POST',"
        "headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})}"
        "else{await api('/api/schedule/events',{method:'POST',headers:{'Content-Type':'application/json'},"
        "body:JSON.stringify(body)})}schedCloseEdit();toast('Saved');paintEvents(await api('/api/schedule/events'))};"
        "$('sd-cancel').onclick=schedCloseDel;"
        "$('sched-del-modal').onclick=e=>{if(e.target===$('sched-del-modal'))schedCloseDel()};"
        "$('sd-confirm').onclick=async()=>{if(delIndex<0)return;"
        "await api('/api/schedule/events/delete',{method:'POST',headers:{'Content-Type':'application/json'},"
        "body:JSON.stringify({index:delIndex})});schedCloseDel();toast('Deleted');"
        "paintEvents(await api('/api/schedule/events'))};"
        "paintEvents(evData);"
        "$('save-sch').onclick=async()=>{await saveCfg({wind_down_sec:+ $('wd').value,sleep_sec:+ $('sl').value,rest_sec:+ $('rs').value})};"
        "startPoll(5000,async()=>{try{mergeCfgFromApi(await api('/api/config'));patchVal('wd',cfg.wind_down_sec);"
        "patchVal('sl',cfg.sleep_sec);patchVal('rs',cfg.rest_sec);if($('sched-edit-modal').classList.contains('hidden')"
        "&&$('sched-del-modal').classList.contains('hidden'))paintEvents(await api('/api/schedule/events'))}catch(e){}});}"
        "async function pageTimeouts(el){await ensureCfg();"
        "el.innerHTML='<div class=\"card\"><h2>Screen timeouts (seconds)</h2>'"
        "+numField('t0','Splash',cfg.timeout_splash_sec)+numField('t1','TOD dim',cfg.timeout_tod_dim_sec)"
        "+numField('t2','TOD menu wedge',cfg.timeout_tod_menu_sec)+numField('t3','Adult auth',cfg.timeout_aa_sec)"
        "+numField('t4','Main menu',cfg.timeout_main_menu_sec)+numField('t5','Timer dim',cfg.timeout_timer_dim_sec)"
        "+numField('t6','Timer done',cfg.timeout_timer_done_sec)"
        "+'<button class=\"btn\" id=\"save-to\">Save</button></div>';"
        "$('save-to').onclick=async()=>{await saveCfg({timeout_splash_sec:+ $('t0').value,timeout_tod_dim_sec:+ $('t1').value,"
        "timeout_tod_menu_sec:+ $('t2').value,timeout_aa_sec:+ $('t3').value,timeout_main_menu_sec:+ $('t4').value,"
        "timeout_timer_dim_sec:+ $('t5').value,timeout_timer_done_sec:+ $('t6').value})};"
        "startPoll(5000,async()=>{try{mergeCfgFromApi(await api('/api/config'));patchVal('t0',cfg.timeout_splash_sec);"
        "patchVal('t1',cfg.timeout_tod_dim_sec);patchVal('t2',cfg.timeout_tod_menu_sec);patchVal('t3',cfg.timeout_aa_sec);"
        "patchVal('t4',cfg.timeout_main_menu_sec);patchVal('t5',cfg.timeout_timer_dim_sec);"
        "patchVal('t6',cfg.timeout_timer_done_sec)}catch(e){}});}"
