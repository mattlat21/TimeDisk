        "function statusRow(id,k,v){return '<div class=\"status-row\"><span>'+esc(k)+'</span><span id=\"'+id+'\">'+esc(v)+'</span></div>'}"
        "function formatDurationSec(sec){sec=Math.max(0,Math.floor(Number(sec)||0));"
        "if(sec===0)return '0 sec';"
